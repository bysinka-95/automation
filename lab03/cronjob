# Daily at 06:00: MDL -> EUR rate for the previous day
0 6 * * * /usr/local/bin/python3 /app/currency_exchange_rate.py MDL EUR "$(date -d yesterday +\%F)" --url "$API_URL" >> /var/log/cron.log 2>&1
# Weekly on Friday at 17:00: MDL -> USD rate for the previous week (same day, 7 days ago)
0 17 * * 5 /usr/local/bin/python3 /app/currency_exchange_rate.py MDL USD "$(date -d '7 days ago' +\%F)" --url "$API_URL" >> /var/log/cron.log 2>&1
